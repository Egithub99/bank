# ---------------------------------------------------------------------------
# bol.com Retailer API — read-only connector for the Command Center demo.
# Copy this file to `.env` and fill in your own credentials.
# Leave everything blank to keep running in MOCK mode (no external calls).
# ---------------------------------------------------------------------------
#
# How to get credentials:
#   bol.com seller dashboard -> Instellingen -> API-instellingen
#   -> "Nieuwe API-credentials aanmaken". You get a client id + secret.
#   (Verkopen via bol.com account required.)
#
# NOTHING is sent to bol.com until BOTH of these are true:
#   1. BOL_CLIENT_ID and BOL_CLIENT_SECRET are set, and
#   2. BOL_LIVE=true   (explicit safety gate)
# Until then the connector serves mock data.

BOL_CLIENT_ID=
BOL_CLIENT_SECRET=

# Safety gate. Real (read-only) API calls happen only when this is exactly "true".
BOL_LIVE=false

# --- Optional overrides (sensible defaults if omitted) ---------------------
# Production base (default):
# BOL_API_BASE=https://api.bol.com/retailer
# bol.com demo environment (test without touching real data):
# BOL_API_BASE=https://api.bol.com/retailer-demo
# BOL_API_VERSION=v10
# PORT=8137
